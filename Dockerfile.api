FROM python:3.12-slim

ARG CONTAINER_UID=1000
ARG CONTAINER_GID=1000

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user with specified UID/GID
RUN groupadd -g "${CONTAINER_GID}" appuser && \
    useradd -m -u "${CONTAINER_UID}" -g "${CONTAINER_GID}" -s /bin/bash appuser

WORKDIR /app

RUN pip install --upgrade pip setuptools wheel

COPY api/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

COPY api /app/api

# Set ownership of /app to appuser
RUN chown -R appuser:${CONTAINER_GID} /app

EXPOSE 8000
USER appuser
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
