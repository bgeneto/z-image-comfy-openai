# Public ports
COMFYUI_PORT=8188
OPENAI_API_PORT=8006

# Simple bearer token for the OpenAI-compatible wrapper
API_KEY=changeme-local-token

HF_TOKEN=

# Z-Image-Turbo-AIO Photorealistic FP8 checkpoint
MODEL_REPO=SeeSee21/Z-Image-Turbo-AIO
MODEL_FILE=z-image-turbo-fp8-aio.safetensors
CHECKPOINT_NAME=z-image-turbo-fp8-aio.safetensors

# Optional: install UI-oriented nodes used by the official AIO workflows.
# The generated API workflow below uses core nodes only, but these are useful
# if you later open the UI and import ZIT-AIO-v2.0.json.
INSTALL_OPTIONAL_NODES=true

# ComfyUI runtime flags
COMFYUI_ARGS=--listen 0.0.0.0 --port 8188 --disable-auto-launch

# Generation defaults recommended by the AIO model card
DEFAULT_STEPS=9
DEFAULT_CFG=1.0
DEFAULT_SAMPLER=res_multistep
DEFAULT_SCHEDULER=simple
DEFAULT_DENOISE=1.0
MAX_IMAGES=1

REQUEST_TIMEOUT_SECONDS=180
POLL_INTERVAL_SECONDS=1.0

# Output format: png or webp (default: webp)
DEFAULT_OUTPUT_FORMAT=webp
# WebP quality (1-100, default: 92)
WEBP_QUALITY=92
# WebP lossless mode (true/false, default: false)
WEBP_LOSSLESS=false

# Default image dimensions (must be divisible by 8, range 256-2048)
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024

# Container user UID/GID (default: 1000 for non-root)
CONTAINER_UID=1000
CONTAINER_GID=1000

# Model warmup on startup (reduces first-generation latency)
# Set to true to enable warmup via startup event and /ready endpoint
WARMUP_ENABLED=true
# Number of steps for the warmup generation (default: 2)
WARMUP_STEPS=2
# Size for the warmup image (e.g., 512, default: 512)
WARMUP_SIZE=512
# Delay in seconds before warmup starts, allowing ComfyUI to finish initializing (default: 10)
WARMUP_DELAY=10